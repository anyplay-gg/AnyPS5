
function(observed_exports_write output root)
    set(rows "")
    foreach(library IN LISTS ARGN)
        file(GLOB_RECURSE sources "${root}/${library}/*.cpp")
        list(FILTER sources EXCLUDE REGEX "/tests/")
        list(SORT sources)
        set(names "")
        set(literals "")
        foreach(source IN LISTS sources)
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
            file(READ "${source}" text)
            string(REGEX MATCHALL "[A-Za-z0-9_:<>*& \t]*APS5_VABI[ \t]+[A-Za-z_][A-Za-z_0-9]*[ \t]*\\(" definitions "${text}")
            foreach(definition IN LISTS definitions)
                string(REGEX REPLACE "^(.*)APS5_VABI[ \t]+([A-Za-z_][A-Za-z_0-9]*)[ \t]*\\($" "\\2" name "${definition}")
                string(REGEX REPLACE "^(.*)APS5_VABI[ \t]+([A-Za-z_][A-Za-z_0-9]*)[ \t]*\\($" "\\1" prefix "${definition}")
                if(prefix MATCHES "(^|[ \t])(static|typedef|using|return)([ \t]|$)")
                    continue()
                endif()
                if(name MATCHES "_nid_no_patch(_cut)?$" OR name MATCHES "^SDL_")
                    continue()
                endif()
                if(prefix MATCHES "[*&]")
                    set(kind "-")
                elseif(prefix MATCHES "(^|[^A-Za-z0-9_])bool[ \t]*$")
                    set(kind "b")
                elseif(prefix MATCHES "(^|[^A-Za-z0-9_])(void|float|double|int64_t|uint64_t|size_t|ssize_t|off_t|long|intptr_t|uintptr_t|SceKernelUseconds)[ \t]*$")
                    set(kind "-")
                else()
                    set(kind "i")
                endif()
                if(NOT "${library}:${name}" IN_LIST names)
                    list(APPEND names "${library}:${name}")
                    set(kind_${library}_${name} "${kind}")
                endif()
            endforeach()
            string(REGEX MATCHALL "APS5_EXPORT\\(\"[^\"]+\"[ \t]*,[ \t]*[A-Za-z_][A-Za-z_0-9]*[ \t]*\\)" exports "${text}")
            foreach(export IN LISTS exports)
                string(REGEX REPLACE "^APS5_EXPORT\\(\"([^\"]+)\"[ \t]*,[ \t]*([A-Za-z_][A-Za-z_0-9]*)[ \t]*\\)$" "\\1:\\2" literal "${export}")
                list(APPEND literals "${literal}")
            endforeach()
        endforeach()
        foreach(entry IN LISTS names)
            string(REPLACE "${library}:" "" name "${entry}")
            string(APPEND rows "    {\"${library}\", \"${name}\", nullptr, '${kind_${library}_${name}}'},\n")
        endforeach()
        foreach(literal IN LISTS literals)
            string(REGEX REPLACE "^([^:]*):(.*)$" "\\1" nid "${literal}")
            string(REGEX REPLACE "^([^:]*):(.*)$" "\\2" name "${literal}")
            if(DEFINED kind_${library}_${name})
                set(kind "${kind_${library}_${name}}")
            else()
                set(kind "i")
            endif()
            string(APPEND rows "    {\"${library}\", \"${name}\", \"${nid}\", '${kind}'},\n")
        endforeach()
    endforeach()
    set(current "")
    if(EXISTS "${output}")
        file(READ "${output}" current)
    endif()
    if(NOT current STREQUAL rows)
        file(WRITE "${output}" "${rows}")
    endif()
endfunction()
